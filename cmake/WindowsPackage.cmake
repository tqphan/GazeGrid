if(GAZE_GRID_WITH_TOBII)
  set(GAZE_GRID_TOBII_INSTALL_MESSAGE "This build includes eye-tracker support. Install the Tobii Experience software for your tracker before using eye tracking.")
else()
  set(GAZE_GRID_TOBII_INSTALL_MESSAGE "This is a mouse-dwell build. Eye tracking also requires a tracker-enabled gaze-grid build; installing Tobii Experience software alone will not enable it.")
endif()
# Executables are mutually exclusive WiX components, selected by the trust choice.
set(GAZE_GRID_CERTIFICATE_THUMBPRINT "" CACHE STRING "Public signing certificate thumbprint")
configure_file("${CMAKE_SOURCE_DIR}/platform/windows/Installer.wxs.in"
  "${CMAKE_BINARY_DIR}/Installer.wxs" @ONLY)
set(CPACK_WIX_EXTRA_SOURCES "${CMAKE_BINARY_DIR}/Installer.wxs")
set(CPACK_WIX_PATCH_FILE "${CMAKE_SOURCE_DIR}/platform/windows/InstallerPatch.xml")
set(CPACK_WIX_EXTENSIONS WixIIsExtension WixUtilExtension)
# ICE30 does not evaluate mutually exclusive component conditions.
set(CPACK_WIX_LIGHT_EXTRA_FLAGS -sice:ICE30
  -loc "${CMAKE_SOURCE_DIR}/platform/windows/Installer.en-us.wxl")
install(DIRECTORY references/optikey-keyboard-en-us/ DESTINATION keyboards)
install(FILES LICENSE.txt DESTINATION .)
# windeployqt output is populated by Build-Release.ps1 before CPack runs.
set(GAZE_GRID_DEPLOY_DIR "${CMAKE_BINARY_DIR}/deploy" CACHE PATH "Qt deployment directory")
install(DIRECTORY "${GAZE_GRID_DEPLOY_DIR}/" DESTINATION .)
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "Windows MSI packaging currently requires x64")
endif()
# Ship the MSVC runtime app-locally so a clean Windows machine can launch.
set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION .)
set(CMAKE_INSTALL_UCRT_LIBRARIES TRUE)
include(InstallRequiredSystemLibraries)
set(CPACK_GENERATOR WIX)
set(CPACK_WIX_VERSION 3)
set(CPACK_WIX_PRODUCT_ICON "${CMAKE_SOURCE_DIR}/resources/gaze-grid.ico")
set(CPACK_PACKAGE_NAME gaze-grid)
set(CPACK_PACKAGE_VENDOR gaze-grid)
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_INSTALL_DIRECTORY gaze-grid)

set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE.txt")
set(CPACK_WIX_UPGRADE_GUID "6F4B404F-F3D9-4EB1-8C9C-DFBF9D9252A8")
set(CPACK_WIX_UI_REF gaze_gridUI)
set(CPACK_WIX_ARCHITECTURE x64)
include(CPack)
