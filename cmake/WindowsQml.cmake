# Keep the KDE desktop styling on Linux; build a Qt-only variant on Windows.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/ui/Main.qml")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/ui/Main.qml" qml)
string(REPLACE "import org.kde.desktop as Desktop" "import QtQuick.Controls as Desktop" qml "${qml}")
string(REPLACE "import org.kde.kirigami as Kirigami" "" qml "${qml}")
string(REPLACE "id: root" "id: root\n SystemPalette { id: systemPalette }" qml "${qml}")
foreach(pair "backgroundColor|window" "textColor|windowText" "disabledTextColor|mid" "highlightColor|highlight" "positiveTextColor|highlight" "neutralTextColor|windowText")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 old)
  list(GET parts 1 new)
  string(REPLACE "Kirigami.Theme.${old}" "systemPalette.${new}" qml "${qml}")
endforeach()
string(REGEX REPLACE "Kirigami.Theme.(colorSet|inherit):[^\n]+" "" qml "${qml}")
string(REPLACE "Kirigami.Units.largeSpacing" "12" qml "${qml}")
string(REPLACE "Kirigami.Heading" "Desktop.Label" qml "${qml}")
string(REPLACE "level:1" "font.pixelSize:24" qml "${qml}")
string(REPLACE "Kirigami.Separator {Layout.fillHeight:true}" "Rectangle {Layout.fillHeight:true;implicitWidth:1;color:systemPalette.mid}" qml "${qml}")
string(REPLACE "Kirigami.Separator {Layout.fillWidth:true}" "Rectangle {Layout.fillWidth:true;implicitHeight:1;color:systemPalette.mid}" qml "${qml}")
set(MAIN_QML "${CMAKE_CURRENT_BINARY_DIR}/windows-ui/Main.qml")
file(WRITE "${MAIN_QML}" "${qml}")
set_source_files_properties("${MAIN_QML}" PROPERTIES QT_RESOURCE_ALIAS "ui/Main.qml")
