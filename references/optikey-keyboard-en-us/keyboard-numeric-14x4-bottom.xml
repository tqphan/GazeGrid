<Keyboard>
  <Name>OptiKey-HorizontalBoard</Name>
  <Height>46%</Height>
  <SymbolMargin>12</SymbolMargin>
  <DockSize>Full</DockSize>
  <Position>Bottom</Position>
  <Width>100%</Width>
  <HorizontalOffset>0</HorizontalOffset>
  <VerticalOffset>0</VerticalOffset>
  <WindowState>Floating</WindowState>
  <HideFromKeyboardMenu>true</HideFromKeyboardMenu>
  <PersistNewState>false</PersistNewState>
  <Grid>
    <Rows>4</Rows>
    <Cols>14</Cols>
  </Grid>
  <Content>
    <!-- Row 0 -->
    <DynamicKey>
      <Symbol>UpArrowKeyIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="false">keyboard-numeric-14x4-top</ChangeKeyboard>
      <KeyGroup>Mirror</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>AlphaIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="false">keyboard-alphabet-14x4-bottom</ChangeKeyboard>
      <KeyGroup>Pagination</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>EraserIcon</Symbol>
      <Action>ClearScratchpad</Action>
      <KeyGroup>Exit</KeyGroup>
    </DynamicKey>
    <SuggestionRow Width="8">
      <KeyGroup>Suggestion</KeyGroup>
    </SuggestionRow>
    <DynamicKey>
      <Symbol>ConversationIcon</Symbol>
      <KeyDown>LWIN</KeyDown>
      <Text>c</Text>
      <KeyUp>LWIN</KeyUp>
      <Action>ClearScratchpad</Action>
      <KeyGroup>Exit</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>PhysicalKeysIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="false">keyboard-function-14x4-bottom</ChangeKeyboard>
      <KeyGroup>Pagination</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>NoIcon</Symbol>
      <Action>BackFromKeyboard</Action>
      <KeyGroup>Exit</KeyGroup>
    </DynamicKey>
    <!-- Row 1 -->
    <DynamicKey>
      <Symbol>ShiftKeyIcon</Symbol>
      <Action>LeftShift</Action>
      <KeyGroup>Modifier</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>!</ShiftDownLabel>
      <Label>1</Label>
      <Text>1</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>@</ShiftDownLabel>
      <Label>2</Label>
      <Text>2</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>#</ShiftDownLabel>
      <Label>3</Label>
      <Text>3</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>$</ShiftDownLabel>
      <Label>4</Label>
      <Text>4</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>%</ShiftDownLabel>
      <Label>5</Label>
      <Text>5</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>^</ShiftDownLabel>
      <Label>6</Label>
      <Text>6</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>&amp;</ShiftDownLabel>
      <Label>7</Label>
      <Text>7</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>*</ShiftDownLabel>
      <Label>8</Label>
      <Text>8</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>(</ShiftDownLabel>
      <Label>9</Label>
      <Text>9</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>)</ShiftDownLabel>
      <Label>0</Label>
      <Text>0</Text>
      <KeyGroup>Numeric</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>_</ShiftDownLabel>
      <Label>-</Label>
      <Text>-</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>+</ShiftDownLabel>
      <Label>=</Label>
      <Text>=</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>BackspaceKeyIcon</Symbol>
      <Action>BackOne</Action>
      <KeyGroup>Modifier</KeyGroup>
    </DynamicKey>
    <!-- Row 2 -->
    <DynamicKey>
      <Symbol>WinKeyIcon</Symbol>
      <Action>LeftWin</Action>
      <KeyGroup>Modifier</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>!</Label>
      <Text>!</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>@</Label>
      <Text>@</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>#</Label>
      <Text>#</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>$</Label>
      <Text>$</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>%</Label>
      <Text>%</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>^</Label>
      <Text>^</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>&amp;</Label>
      <Text>&amp;</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>*</Label>
      <Text>*</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>|</ShiftDownLabel>
      <Label>\</Label>
      <Text>\</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>⮝</Label>
      <KeyDown>UP</KeyDown>
      <KeyUp>UP</KeyUp>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>/</Label>
      <Text>/</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>+</Label>
      <Text>+</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>EnterIcon</Symbol>
      <Text>&#13;</Text>
      <KeyGroup>Modifier</KeyGroup>
    </DynamicKey>
    <!-- Row 3 -->
    <DynamicKey>
      <Symbol>CtrlKeyIcon</Symbol>
      <Action>LeftCtrl</Action>
      <KeyGroup>Modifier</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>AltKeyIcon</Symbol>
      <Action>LeftAlt</Action>
      <KeyGroup>Modifier</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>␣</Label>
      <Text>&#32;</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>(</Label>
      <Text>(</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>)</Label>
      <Text>)</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>[</Label>
      <Text>[</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>]</Label>
      <Text>]</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>{</Label>
      <Text>{</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>}</Label>
      <Text>}</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>⮜</Label>
      <KeyDown>LEFT</KeyDown>
      <KeyUp>LEFT</KeyUp>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>⮟</Label>
      <KeyDown>DOWN</KeyDown>
      <KeyUp>DOWN</KeyUp>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>⮞</Label>
      <KeyDown>RIGHT</KeyDown>
      <KeyUp>RIGHT</KeyUp>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>></ShiftDownLabel>
      <Label>.</Label>
      <Text>.</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>~</ShiftDownLabel>
      <Label>`</Label>
      <Text>`</Text>
      <KeyGroup>Punctuation</KeyGroup>
    </DynamicKey>
  </Content>
</Keyboard>