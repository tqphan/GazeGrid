<Keyboard>
  <Name>SCK - Web 1 - Bottom</Name>
  <Width>100%</Width>
  <Height>11.50%</Height>
  <SymbolMargin>12</SymbolMargin>
  <DockSize>Full</DockSize>
  <Position>Bottom</Position>
  <HorizontalOffset>0</HorizontalOffset>
  <VerticalOffset>0</VerticalOffset>
  <WindowState>Floating</WindowState>
  <HideFromKeyboardMenu>true</HideFromKeyboardMenu>
  <PersistNewState>false</PersistNewState>
  <Grid>
    <Rows>1</Rows>
    <Cols>14</Cols>
  </Grid>
  <KeyGroup 
    BackgroundColor="#180F23" 
    ForegroundColor="#ffffff" 
    ForegroundOpacity="0.75"
    Name="All" />
  <KeyGroup Name="Alphabet" />
  <KeyGroup Name="Numbers" />
  <KeyGroup Name="Punctuations" />
  <KeyGroup Name="Modifiers" />
  <KeyGroup Name="Functions" />
  <KeyGroup Name="Predictions" />
  <KeyGroup Name="Conversations" />
  <KeyGroup Name="Others" />
  <KeyGroup Name="Navigation" />
  <KeyGroup Name="Editing" />
  <KeyGroup Name="Mouse" />
  <KeyGroup Name="Gamepad" />
  <Content>
    <DynamicKey>
      <Symbol>UpArrowKeyIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">game-14x1-top</ChangeKeyboard>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>Gamepad</Label>
      <ChangeKeyboard BackReturnsHere="true">game-controller</ChangeKeyboard>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>EscapeKeyIcon</Symbol>
      <KeyToggle>Escape</KeyToggle>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>␣</Label>
      <KeyDown>SPACE</KeyDown>
      <Wait>10</Wait>
      <KeyUp>SPACE</KeyUp>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>C</ShiftDownLabel>
      <Label>c</Label>  
      <KeyDown>c</KeyDown>
      <Wait>10</Wait>
      <KeyUp>c</KeyUp>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>I</ShiftDownLabel>
      <Label>i</Label>  
      <KeyDown>i</KeyDown>
      <Wait>10</Wait>
      <KeyUp>i</KeyUp>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>KeyboardIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">keyboard-alphabet-14x4-bottom</ChangeKeyboard>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MouseNeutralIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">mouse-14x1-bottom</ChangeKeyboard>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>F</ShiftDownLabel>
      <Label>f</Label>  
      <KeyDown>f</KeyDown>
      <Wait>10</Wait>
      <KeyUp>f</KeyUp>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>Q</ShiftDownLabel>
      <Label>q</Label>  
      <KeyDown>q</KeyDown>
      <Wait>10</Wait>
      <KeyUp>q</KeyUp>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>W</ShiftDownLabel>
      <Label>w</Label>  
      <KeyToggle>w</KeyToggle>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>E</ShiftDownLabel>
      <Label>e</Label>  
      <KeyDown>e</KeyDown>
      <Wait>10</Wait>
      <KeyUp>e</KeyUp>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MoreIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">game-14x2-bottom</ChangeKeyboard>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MinimizeDownIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">minimized-off-screen-bottom</ChangeKeyboard>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
  </Content>
</Keyboard>