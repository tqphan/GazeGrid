<Keyboard>
  <Name>SCK - Gaze Bar - Bottom</Name>
  <Width>100%</Width>
  <Height>11.50%</Height>
  <SymbolMargin>12</SymbolMargin>
  <DockSize>Full</DockSize>
  <Position>Bottom</Position>
  <HorizontalOffset>0</HorizontalOffset>
  <VerticalOffset>0</VerticalOffset>
  <WindowState>Floating</WindowState>
  <PersistNewState>false</PersistNewState>
  <HideFromKeyboardMenu>true</HideFromKeyboardMenu>
  <Grid>
    <Rows>1</Rows>
    <Cols>14</Cols>
  </Grid>
  <KeyGroup 
    BackgroundColor="#230F18" 
    ForegroundColor="#ffffff" 
    ForegroundOpacity="0.75"
    Name="Default" />
  <Content>
    <DynamicKey>
      <Symbol>UpArrowKeyIcon</Symbol>
  <BorderThickness>3,3,3,3</BorderThickness>
  <BorderColor>#ff0000</BorderColor>
      <ChangeKeyboard BackReturnsHere="true">main-14x1-top</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>ArrowsAllDirectionsIcon</Symbol>    
      <Action>MouseMagneticCursor</Action>
    </DynamicKey>
    <DynamicKey>
      <Symbol>LookToScrollActiveIcon</Symbol>
      <Action>LookToScrollActive</Action>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MouseLeftButtonClickIcon</Symbol>
      <Action>MouseMoveAndLeftClick</Action>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MouseRightButtonClickIcon</Symbol>
      <Action>MouseMoveAndRightClick</Action>
    </DynamicKey>
    <DynamicKey>
      <Symbol>DpadIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">game-14x1-bottom</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>KeyboardIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">keyboard-alphabet-14x4-bottom</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MouseNeutralIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">mouse-14x1-bottom</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>BrowserIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">web-14x1-bottom</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>WinKeyIcon</Symbol>
      <KeyDown>LWIN</KeyDown>
      <KeyUp>LWIN</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Symbol>TransferUpDownIcon</Symbol>
      <KeyDown>LWIN</KeyDown>
      <KeyDown>LSHIFT</KeyDown>
      <KeyDown>LEFT</KeyDown>
      <KeyUp>LEFT</KeyUp>
      <KeyUp>LSHIFT</KeyUp>
      <KeyUp>LWIN</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Symbol>CtrlAltTabIcon</Symbol>
      <KeyDown>LMenu</KeyDown>
      <KeyDown>LCONTROL</KeyDown>
      <KeyDown>TAB</KeyDown>
      <KeyUp>TAB</KeyUp>
      <KeyUp>LMenu</KeyUp>
      <KeyUp>LCONTROL</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Symbol>ConversationIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">keyboard-conversation-fullscreen</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MinimizeDownIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">minimized-off-screen-bottom</ChangeKeyboard>
    </DynamicKey>
  </Content>
</Keyboard>