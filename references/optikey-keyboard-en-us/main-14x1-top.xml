<Keyboard>
  <Name>SCK - Gaze Bar - Top</Name>
  <Width>100%</Width>
  <Height>11.50%</Height>
  <SymbolMargin>12</SymbolMargin>
  <DockSize>Full</DockSize>
  <Position>Top</Position>
  <HorizontalOffset>0</HorizontalOffset>
  <VerticalOffset>0</VerticalOffset>
  <WindowState>Floating</WindowState>
  <HideFromKeyboardMenu>false</HideFromKeyboardMenu>
  <PersistNewState>false</PersistNewState>
  <Grid>
    <Rows>1</Rows>
    <Cols>14</Cols>
  </Grid>
  <KeyGroup
    BackgroundColor="#18230F"
    ForegroundColor="#ffffff"
    ForegroundOpacity="0.75"
    Name="Default" />
  <Content>
    <DynamicKey>
      <Symbol>DownArrowKeyIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">main-14x1-bottom</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>ArrowsAllDirectionsIcon</Symbol>
      <Action>MouseMagneticCursor</Action>
    </DynamicKey>
    <DynamicKey>
      <Symbol>LookToScrollActiveIcon</Symbol>
      <Action>LookToScrollActive</Action>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MouseLeftButtonClickIcon</Symbol>
      <Action>MouseMoveAndLeftClick</Action>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MouseRightButtonClickIcon</Symbol>
      <Action>MouseMoveAndRightClick</Action>
    </DynamicKey>
    <DynamicKey>
      <Symbol>DpadIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">game-14x1-top</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>KeyboardIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">keyboard-alphabet-14x4-top</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MouseNeutralIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">mouse-14x1-top</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>BrowserIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">web-14x1-top</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>WinKeyIcon</Symbol>
      <KeyDown>LWIN</KeyDown>
      <KeyUp>LWIN</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Symbol>TransferUpDownIcon</Symbol>
      <KeyDown>LWIN</KeyDown>
      <KeyDown>LSHIFT</KeyDown>
      <KeyDown>LEFT</KeyDown>
      <KeyUp>LEFT</KeyUp>
      <KeyUp>LSHIFT</KeyUp>
      <KeyUp>LWIN</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Symbol>SearchTextIcon</Symbol>
      <!-- <Symbol>CtrlAltTabIcon</Symbol> -->
      <KeyDown>LCONTROL</KeyDown>
      <KeyDown>LSHIFT</KeyDown>
      <Text>m</Text>
      <KeyUp>LSHIFT</KeyUp>
      <KeyUp>LCONTROL</KeyUp>
      <!-- <Action>MenuKeyboard</Action> -->
    </DynamicKey>
    <DynamicKey>
      <Symbol>ConversationIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">keyboard-conversation-fullscreen</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MinimiseIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">minimized-off-screen-top</ChangeKeyboard>
    </DynamicKey>
  </Content>
</Keyboard>