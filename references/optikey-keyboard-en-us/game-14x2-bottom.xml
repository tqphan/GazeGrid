<Keyboard>
  <Name>SCK - Web 2 - Bottom</Name>
  <Width>100%</Width>
  <Height>23%</Height>
  <SymbolMargin>12</SymbolMargin>
  <DockSize>Full</DockSize>
  <Position>Bottom</Position>
  <HorizontalOffset>0</HorizontalOffset>
  <VerticalOffset>0</VerticalOffset>
  <WindowState>Floating</WindowState>
  <HideFromKeyboardMenu>true</HideFromKeyboardMenu>
  <PersistNewState>false</PersistNewState>
  <Grid>
    <Rows>2</Rows>
    <Cols>14</Cols>
  </Grid>
  <KeyGroup 
    BackgroundColor="#180F23" 
    ForegroundColor="#ffffff" 
    ForegroundOpacity="0.75"
    Name="All" />
  <Content>
    <DynamicKey>
      <Symbol>UpArrowKeyIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">game-14x2-top</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>ArrowsAllDirectionsIcon</Symbol>
      <Action>MouseMagneticCursor</Action>
    </DynamicKey>
    <DynamicKey>
      <Symbol>EscapeKeyIcon</Symbol>
      <KeyToggle>Escape</KeyToggle>
    </DynamicKey>
    <DynamicKey>
      <Label>␣</Label>
      <KeyDown>SPACE</KeyDown>
      <Wait>10</Wait>
      <KeyUp>SPACE</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>C</ShiftDownLabel>
      <Label>c</Label>  
      <KeyDown>c</KeyDown>
      <Wait>10</Wait>
      <KeyUp>c</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>I</ShiftDownLabel>
      <Label>i</Label>  
      <KeyDown>i</KeyDown>
      <Wait>10</Wait>
      <KeyUp>i</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Symbol>KeyboardIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">keyboard-alphabet-14x4-bottom</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MouseNeutralIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">mouse-14x1-bottom</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>F</ShiftDownLabel>
      <Label>f</Label>  
      <KeyDown>f</KeyDown>
      <Wait>10</Wait>
      <KeyUp>f</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>Q</ShiftDownLabel>
      <Label>q</Label>  
      <KeyDown>q</KeyDown>
      <Wait>10</Wait>
      <KeyUp>q</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>W</ShiftDownLabel>
      <Label>w</Label>  
      <KeyToggle>w</KeyToggle>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>E</ShiftDownLabel>
      <Label>e</Label>  
      <KeyDown>e</KeyDown>
      <Wait>10</Wait>
      <KeyUp>e</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Symbol>MoreIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">game-14x1-bottom</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>NoIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="true">main-14x1-bottom</ChangeKeyboard>
    </DynamicKey>
    <DynamicKey>
      <Symbol>ShiftKeyIcon</Symbol>
      <KeyToggle>LSHIFT</KeyToggle>
    </DynamicKey>
    <DynamicKey>
      <Symbol>CtrlKeyIcon</Symbol>
      <KeyToggle>LCTRL</KeyToggle>
    </DynamicKey>
    <DynamicKey>
      <Symbol>AltKeyIcon</Symbol>
      <KeyToggle>LMENU</KeyToggle>
    </DynamicKey>
    <DynamicKey>
      <Symbol>WinKeyIcon</Symbol>
      <KeyToggle>LWin</KeyToggle>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>Z</ShiftDownLabel>
      <Label>z</Label>
      <KeyDown>z</KeyDown>
      <Wait>10</Wait>
      <KeyUp>z</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Label>1</Label>
      <KeyDown>VK_1</KeyDown>
      <Wait>10</Wait>
      <KeyUp>VK_1</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Label>2</Label>
      <KeyDown>VK_2</KeyDown>
      <Wait>10</Wait>
      <KeyUp>VK_2</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Label>3</Label>
      <KeyDown>VK_3</KeyDown>
      <Wait>10</Wait>
      <KeyUp>VK_3</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <Label>4</Label>
      <KeyDown>VK_4</KeyDown>
      <Wait>10</Wait>
      <KeyUp>VK_4</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>A</ShiftDownLabel>
      <Label>a</Label>
      <KeyToggle>a</KeyToggle>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>S</ShiftDownLabel>
      <Label>s</Label>
      <KeyToggle>s</KeyToggle>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>D</ShiftDownLabel>
      <Label>d</Label>
      <KeyToggle>d</KeyToggle>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>X</ShiftDownLabel>
      <Label>x</Label>
      <KeyDown>x</KeyDown>
      <Wait>10</Wait>
      <KeyUp>x</KeyUp>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>R</ShiftDownLabel>
      <Label>r</Label>
      <KeyDown>r</KeyDown>
      <Wait>10</Wait>
      <KeyUp>r</KeyUp>
    </DynamicKey>
  </Content>
</Keyboard>