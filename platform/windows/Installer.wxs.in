<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:iis="http://schemas.microsoft.com/wix/IIsExtension">
  <Fragment>
    <!-- Certificate trust is selected by default, including silent installs. Repairs retain the
         original choice; changing mode requires uninstall/reinstall or upgrade. -->
    <Property Id="GAZEGRID_TRUST_CERTIFICATE" Value="1" Secure="yes" />
    <Property Id="GAZEGRID_SAVED_MODE" Secure="yes">
      <RegistrySearch Id="SavedMode" Root="HKLM" Key="Software\GazeGrid\Installer" Name="TrustCertificate" Type="raw" Win64="yes" />
    </Property>
    <SetProperty Id="GAZEGRID_TRUST_CERTIFICATE" Value="[GAZEGRID_SAVED_MODE]" After="AppSearch" Sequence="both">Installed AND GAZEGRID_SAVED_MODE</SetProperty>
    <Property Id="GAZEGRID_SIGN_IN" Value="1" Secure="yes" />
    <Property Id="GAZEGRID_SAVED_SIGN_IN" Secure="yes">
      <RegistrySearch Id="SavedSignIn" Root="HKLM" Key="Software\GazeGrid\Installer" Name="SignIn" Type="raw" Win64="yes" />
    </Property>
    <!-- Restore unchecked (empty) and explicit silent opt-out (0) as well as 1.
         Declining trust must also turn off the default during quiet setup. -->
    <SetProperty Id="GAZEGRID_SIGN_IN" Value="[GAZEGRID_SAVED_SIGN_IN]" After="SetGAZEGRID_TRUST_CERTIFICATE" Sequence="both">Installed</SetProperty>
    <SetProperty Id="GAZEGRID_SIGN_IN" Action="DisableUntrustedSignIn" Value="" After="SetGAZEGRID_SIGN_IN" Sequence="both">GAZEGRID_TRUST_CERTIFICATE &lt;&gt; "1"</SetProperty>
    <Condition Message="Starting before Windows sign-in requires accepting certificate trust.">NOT (GAZEGRID_SIGN_IN = "1") OR GAZEGRID_TRUST_CERTIFICATE = "1" OR REMOVE = "ALL"</Condition>
    <Binary Id="SignInActions" SourceFile="@CMAKE_BINARY_DIR@/Release/gazegrid_sign_in_actions.dll" />
    <CustomAction Id="PrepareSignIn" BinaryKey="SignInActions" DllEntry="PrepareSignIn" Execute="immediate" Return="check" />
    <CustomAction Id="RollbackSignIn" BinaryKey="SignInActions" DllEntry="RollbackSignIn" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="ApplySignIn" BinaryKey="SignInActions" DllEntry="ApplySignIn" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="PrepareSignIn" Before="InstallInitialize">1</Custom>
      <Custom Action="RollbackSignIn" After="WriteRegistryValues">1</Custom>
      <Custom Action="ApplySignIn" After="RollbackSignIn">1</Custom>
    </InstallExecuteSequence>
    <Icon Id="GazeGrid.exe" SourceFile="@CMAKE_SOURCE_DIR@/resources/gazegrid.ico" />
    <Binary Id="GazeGridPublicCer" SourceFile="@CMAKE_BINARY_DIR@/GazeGrid.cer" />
    <DirectoryRef Id="INSTALL_ROOT">
      <Component Id="GazeGridSigned" Guid="EBDB964C-AE84-4B98-B95F-17EF4DA6A48D" Win64="yes">
        <Condition>GAZEGRID_TRUST_CERTIFICATE = "1"</Condition>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\Accessibility\ATs\GazeGrid_GazeGrid_v1" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="ApplicationName" Value="@[INSTALL_ROOT]gazegrid.exe,-101" Type="string" />
          <RegistryValue Name="Description" Value="@[INSTALL_ROOT]gazegrid.exe,-102" Type="string" />
          <RegistryValue Name="ATExe" Value="gazegrid.exe" Type="string" />
          <RegistryValue Name="StartExe" Value="[INSTALL_ROOT]gazegrid.exe" Type="string" />
          <RegistryValue Name="StartParams" Value="--accessibility" Type="string" />
          <RegistryValue Name="SimpleProfile" Value="On-screen keyboard" Type="string" />
          <RegistryValue Name="Profile" Value="&lt;HCIModel&gt;&lt;Accommodation type=&quot;severe dexterity&quot;/&gt;&lt;Accommodation type=&quot;mild dexterity&quot;/&gt;&lt;/HCIModel&gt;" Type="string" />
          <RegistryValue Name="TerminateOnDesktopSwitch" Value="0" Type="integer" />
          <RegistryValue Name="PassiveAutoStartBehavior" Value="1" Type="integer" />
        </RegistryKey>
        <!-- Direct launches use the unmanaged AT lifecycle and one instance per
             desktop. The normal instance releases tracking while inactive;
             Winlogon selects the restricted UI and never sends Win+U. -->
        <RemoveRegistryValue Id="RemoveLegacySecureDesktopAccommodation" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\Accessibility\ATs\GazeGrid_GazeGrid_v1" Name="SecureDesktopAccommodation" />
        <RemoveRegistryValue Id="RemoveLegacySignInStartParams" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\Accessibility\ATs\GazeGrid_GazeGrid_v1" Name="StartParams" />
        <File Id="GazeGridSignedExe" Source="@CMAKE_BINARY_DIR@/Release/gazegrid.exe" KeyPath="yes">
          <Shortcut Id="GazeGridSignedStart" Directory="GazeGridMenu" Name="GazeGrid" Icon="GazeGrid.exe" IconIndex="0" Advertise="yes" WorkingDirectory="INSTALL_ROOT" />
        </File>
      </Component>
      <Component Id="GazeGridUnsigned" Guid="CBE8E2AD-971E-4B24-8BF6-498EF7CC35BF" Win64="yes">
        <Condition>GAZEGRID_TRUST_CERTIFICATE &lt;&gt; "1"</Condition>
        <File Id="GazeGridUnsignedExe" Source="@CMAKE_BINARY_DIR@/unsigned/gazegrid.exe" KeyPath="yes">
          <Shortcut Id="GazeGridUnsignedStart" Directory="GazeGridMenu" Name="GazeGrid" Icon="GazeGrid.exe" IconIndex="0" Advertise="yes" WorkingDirectory="INSTALL_ROOT" />
        </File>
      </Component>
      <Component Id="GazeGridSignInSettings" Guid="606D5C33-1467-41D9-8F2E-D64BFBA36740" Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\GazeGrid\SignIn" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="Installed" Value="1" Type="integer" KeyPath="yes" />
        </RegistryKey>
      </Component>
      <Component Id="GazeGridMode" Guid="C208D796-4B5F-4282-AB70-020BC516DF9D" Win64="yes">
        <RemoveFolder Id="RemoveGazeGridMenu" Directory="GazeGridMenu" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\GazeGrid\Installer" Name="TrustCertificate" Value="[GAZEGRID_TRUST_CERTIFICATE]" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\GazeGrid\Installer" Name="SignIn" Value="[GAZEGRID_SIGN_IN]" Type="string" />
      </Component>
      <!-- Trust is deliberately persistent: never remove a root that may already
           be trusted by an administrator or used by another GazeGrid release. -->
      <Component Id="GazeGridCertificate" Guid="*" Win64="yes" Permanent="yes">
        <Condition>GAZEGRID_TRUST_CERTIFICATE = "1"</Condition>
        <RegistryValue Root="HKLM" Key="Software\GazeGrid\Certificates" Name="@GAZEGRID_CERTIFICATE_THUMBPRINT@" Value="1" Type="integer" KeyPath="yes" />
        <iis:Certificate Id="GazeGridTrust" Name="GazeGrid" BinaryKey="GazeGridPublicCer" StoreLocation="localMachine" StoreName="root" Request="no" Overwrite="no" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="ProgramMenuFolder">
        <Directory Id="GazeGridMenu" Name="GazeGrid" />
      </Directory>
    </DirectoryRef>
    <ComponentGroup Id="GazeGridExecutables">
      <ComponentRef Id="GazeGridSigned" />
      <ComponentRef Id="GazeGridUnsigned" />
      <ComponentRef Id="GazeGridMode" />
      <ComponentRef Id="GazeGridSignInSettings" />
      <ComponentRef Id="GazeGridCertificate" />

    </ComponentGroup>
  </Fragment>
  <Fragment>
    <UI Id="GazeGridUI">
      <UIRef Id="WixUI_Minimal" />
      <Dialog Id="GazeGridTrustDlg" Width="370" Height="330" Title="GazeGrid accessibility permissions">
        <Control Id="Title" Type="Text" X="15" Y="12" Width="340" Height="20" Text="{\WixUI_Font_Title}Choose Windows accessibility access" />
        <Control Id="Explanation" Type="Text" X="15" Y="40" Width="340" Height="48" Text="A trusted signature and installation in Program Files grant UIAccess, allowing input to elevated windows. Optional sign-in startup is registered separately with Windows accessibility." />
        <Control Id="TrustExplanation" Type="Text" X="15" Y="92" Width="340" Height="48" Text="Accepting installs the self-signed GazeGrid certificate in this computer's Trusted Root Certification Authorities store. This trusts software signed with this identity for all users. Accept only if you trust the publisher and have verified the certificate." />
        <Control Id="Fingerprint" Type="Text" X="15" Y="143" Width="340" Height="28" Text="Certificate thumbprint: @GAZEGRID_CERTIFICATE_THUMBPRINT@" />
        <Control Id="Choice" Type="RadioButtonGroup" Property="GAZEGRID_TRUST_CERTIFICATE" X="15" Y="175" Width="340" Height="40">
          <RadioButtonGroup Property="GAZEGRID_TRUST_CERTIFICATE">
            <RadioButton Value="0" X="0" Y="0" Width="335" Height="17" Text="Decline - install the unsigned, limited-access app" />
            <RadioButton Value="1" X="0" Y="22" Width="335" Height="17" Text="Accept - trust the certificate and install the signed UIAccess app" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Limitations" Type="Text" X="15" Y="224" Width="340" Height="32" Text="If you decline, GazeGrid cannot send input to higher-privilege windows and cannot stay on top of all windows. Normal desktop input remains available." />
        <Control Id="Persistence" Type="Text" X="15" Y="263" Width="340" Height="30" Text="Certificate trust remains after uninstall. An administrator can remove it with certlm.msc under Trusted Root Certification Authorities / Certificates." />
        <Control Id="Next" Type="PushButton" X="204" Y="305" Width="72" Height="17" Default="yes" Text="Next">
          <Publish Property="GAZEGRID_SIGN_IN" Value="{}" Order="1">GAZEGRID_TRUST_CERTIFICATE &lt;&gt; "1"</Publish>
          <Publish Event="EndDialog" Value="Return" Order="2">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="282" Y="305" Width="72" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      <Dialog Id="GazeGridSignInDlg" Width="370" Height="230" Title="GazeGrid Windows sign-in">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" Text="{\WixUI_Font_Title}Keyboard before Windows sign-in" />
        <Control Id="Explanation" Type="Text" X="15" Y="48" Width="340" Height="48" Text="GazeGrid can start on the Windows sign-in screen before you enter your password. It uses the existing keyboard interface with prediction disabled." />
        <Control Id="Enable" Type="CheckBox" X="15" Y="106" Width="340" Height="20" Property="GAZEGRID_SIGN_IN" CheckBoxValue="1" Text="Start GazeGrid before Windows sign-in">
          <Condition Action="disable">GAZEGRID_TRUST_CERTIFICATE &lt;&gt; "1"</Condition>
          <Condition Action="enable">GAZEGRID_TRUST_CERTIFICATE = "1"</Condition>
        </Control>
        <Control Id="Details" Type="Text" X="15" Y="140" Width="340" Height="48" Text="Requires certificate trust. To use your current keyboard and gaze preferences, open Settings > Keyboard > Windows sign-in after installation. Eye tracking also depends on Tobii availability before sign-in." />
        <Control Id="Next" Type="PushButton" X="204" Y="205" Width="72" Height="17" Default="yes" Text="Next"><Publish Event="EndDialog" Value="Return">1</Publish></Control>
        <Control Id="Cancel" Type="PushButton" X="282" Y="205" Width="72" Height="17" Cancel="yes" Text="Cancel"><Publish Event="SpawnDialog" Value="CancelDlg">1</Publish></Control>
      </Dialog>
      <Dialog Id="GazeGridTobiiDlg" Width="370" Height="270" Title="GazeGrid eye tracking setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" Text="{\WixUI_Font_Title}Tobii eye tracking prerequisites" />
        <Control Id="BuildSupport" Type="Text" X="15" Y="45" Width="340" Height="42" Text="@GAZEGRID_TOBII_INSTALL_MESSAGE@" />
        <Control Id="Software" Type="Text" X="15" Y="96" Width="340" Height="50" Text="Install the Tobii Experience driver package, then the Tobii Experience app. That installation supplies the Tobii Stream Engine DLL. GazeGrid uses the installed DLL and does not bundle it." />
        <Control Id="Download" Type="Text" X="15" Y="152" Width="340" Height="24" Text="Official setup: https://gaming.tobii.com/getstarted/" />
        <Control Id="Fallback" Type="Text" X="15" Y="185" Width="340" Height="40" Text="Complete Tobii setup and calibration, then restart GazeGrid. Mouse dwell remains available without Tobii software or a connected eye tracker." />
        <Control Id="Next" Type="PushButton" X="204" Y="245" Width="72" Height="17" Default="yes" Text="Next">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="282" Y="245" Width="72" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      <InstallUISequence>
        <Show Dialog="GazeGridTobiiDlg" Before="GazeGridTrustDlg">NOT Installed</Show>
        <Show Dialog="GazeGridTrustDlg" Before="GazeGridSignInDlg">NOT Installed</Show>
        <Show Dialog="GazeGridSignInDlg" Before="WelcomeEulaDlg">NOT Installed</Show>
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
