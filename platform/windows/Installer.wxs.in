<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:iis="http://schemas.microsoft.com/wix/IIsExtension">
  <Fragment>
    <!-- Certificate trust is selected by default, including silent installs. Repairs retain the
         original choice; changing mode requires uninstall/reinstall or upgrade. -->
    <Property Id="GAZE_GRID_TRUST_CERTIFICATE" Value="1" Secure="yes" />
    <Property Id="GAZE_GRID_SAVED_MODE" Secure="yes">
      <RegistrySearch Id="SavedMode" Root="HKLM" Key="Software\gaze-grid\Installer" Name="TrustCertificate" Type="raw" Win64="yes" />
    </Property>
    <SetProperty Id="GAZE_GRID_TRUST_CERTIFICATE" Value="[GAZE_GRID_SAVED_MODE]" After="AppSearch" Sequence="both">Installed AND GAZE_GRID_SAVED_MODE</SetProperty>
    <Property Id="GAZE_GRID_STARTUP" Secure="yes" />
    <Property Id="GAZE_GRID_SIGN_IN" Value="1" Secure="yes" />
    <Property Id="GAZE_GRID_SAVED_SIGN_IN" Secure="yes">
      <RegistrySearch Id="SavedSignIn" Root="HKLM" Key="Software\gaze-grid\Installer" Name="SignIn" Type="raw" Win64="yes" />
    </Property>
    <!-- Restore unchecked (empty) and explicit silent opt-out (0) as well as 1.
         Declining trust must also turn off the default during quiet setup. -->
    <SetProperty Id="GAZE_GRID_SIGN_IN" Value="[GAZE_GRID_SAVED_SIGN_IN]" After="SetGAZE_GRID_TRUST_CERTIFICATE" Sequence="both">Installed</SetProperty>
    <SetProperty Id="GAZE_GRID_SIGN_IN" Action="DisableUntrustedSignIn" Value="" After="SetGAZE_GRID_SIGN_IN" Sequence="both">GAZE_GRID_TRUST_CERTIFICATE &lt;&gt; "1"</SetProperty>
    <Condition Message="Starting before Windows sign-in requires accepting certificate trust.">NOT (GAZE_GRID_SIGN_IN = "1") OR GAZE_GRID_TRUST_CERTIFICATE = "1" OR REMOVE = "ALL"</Condition>
    <Binary Id="SignInActions" SourceFile="@CMAKE_BINARY_DIR@/Release/gaze-grid_sign_in_actions.dll" />
    <CustomAction Id="PrepareSignIn" BinaryKey="SignInActions" DllEntry="PrepareSignIn" Execute="immediate" Return="check" />
    <CustomAction Id="RollbackSignIn" BinaryKey="SignInActions" DllEntry="RollbackSignIn" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="ApplySignIn" BinaryKey="SignInActions" DllEntry="ApplySignIn" Execute="deferred" Impersonate="no" Return="check" />
    <!-- Launch from the successful Finish dialog in the client UI, after files
         and certificate trust commit. WixShellExec uses ShellExecuteEx, which
         supports UIAccess; an ExeCommand/CreateProcess action fails with 740. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch gaze-grid after setup" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="Launchgaze_grid" BinaryKey="WixCA" DllEntry="WixShellExec" Execute="immediate" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RemoveDesktopStartup" Directory="SystemFolder" ExeCommand='&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v gaze-grid /f' Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RemoveDesktopStartupApproval" Directory="SystemFolder" ExeCommand='&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run&quot; /v gaze-grid /f' Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveDesktopStartup" Before="RemoveRegistryValues">REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RemoveDesktopStartupApproval" After="RemoveDesktopStartup">REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="PrepareSignIn" Before="InstallInitialize">1</Custom>
      <Custom Action="RollbackSignIn" After="WriteRegistryValues">1</Custom>
      <Custom Action="ApplySignIn" After="RollbackSignIn">1</Custom>
    </InstallExecuteSequence>
    <Icon Id="gaze_grid.exe" SourceFile="@CMAKE_SOURCE_DIR@/resources/gaze-grid.ico" />
    <Binary Id="gaze_gridPublicCer" SourceFile="@CMAKE_BINARY_DIR@/gaze-grid.cer" />
    <DirectoryRef Id="INSTALL_ROOT">
      <Component Id="gaze_gridSigned" Guid="F2CEB641-337B-4E0B-81D9-B68BC37B255E" Win64="yes">
        <Condition>GAZE_GRID_TRUST_CERTIFICATE = "1"</Condition>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\Accessibility\ATs\gaze-grid_gaze-grid_v1" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="ApplicationName" Value="@[INSTALL_ROOT]gaze-grid.exe,-101" Type="string" />
          <RegistryValue Name="Description" Value="@[INSTALL_ROOT]gaze-grid.exe,-102" Type="string" />
          <RegistryValue Name="ATExe" Value="gaze-grid.exe" Type="string" />
          <RegistryValue Name="StartExe" Value="[INSTALL_ROOT]gaze-grid.exe" Type="string" />
          <RegistryValue Name="StartParams" Value="--accessibility" Type="string" />
          <RegistryValue Name="SimpleProfile" Value="On-screen keyboard" Type="string" />
          <RegistryValue Name="Profile" Value="&lt;HCIModel&gt;&lt;Accommodation type=&quot;severe dexterity&quot;/&gt;&lt;Accommodation type=&quot;mild dexterity&quot;/&gt;&lt;/HCIModel&gt;" Type="string" />
          <RegistryValue Name="TerminateOnDesktopSwitch" Value="0" Type="integer" />
          <RegistryValue Name="PassiveAutoStartBehavior" Value="1" Type="integer" />
        </RegistryKey>
        <!-- Direct launches use the unmanaged AT lifecycle and one instance per
             desktop. The normal instance releases tracking while inactive;
             Winlogon selects the restricted UI and never sends Win+U. -->
        <RemoveRegistryValue Id="RemoveLegacySecureDesktopAccommodation" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\Accessibility\ATs\gaze-grid_gaze-grid_v1" Name="SecureDesktopAccommodation" />
        <RemoveRegistryValue Id="RemoveLegacySignInStartParams" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\Accessibility\ATs\gaze-grid_gaze-grid_v1" Name="StartParams" />
        <File Id="gaze_gridSignedExe" Source="@CMAKE_BINARY_DIR@/Release/gaze-grid.exe" KeyPath="yes" />
      </Component>
      <Component Id="gaze_gridUnsigned" Guid="3E438E06-166B-42FF-ACA1-D2344A875C76" Win64="yes">
        <Condition>GAZE_GRID_TRUST_CERTIFICATE &lt;&gt; "1"</Condition>
        <File Id="gaze_gridUnsignedExe" Source="@CMAKE_BINARY_DIR@/unsigned/gaze-grid.exe" KeyPath="yes" />
      </Component>
      <!-- Separate key path preserves app changes during repair. -->
      <Component Id="gaze_gridStartup" Guid="0C103E18-0AF3-4DCF-B160-E7483BB875CA" Win64="yes" NeverOverwrite="yes">
        <Condition>GAZE_GRID_STARTUP = "1"</Condition>
        <RegistryValue Root="HKCU" Key="Software\gaze-grid\Installer" Name="Startup" Value="1" Type="integer" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="gaze-grid" Value="&quot;[INSTALL_ROOT]gaze-grid.exe&quot;" Type="string" />
      </Component>
      <Component Id="gaze_gridSignInSettings" Guid="833B331F-8831-4C30-9B50-3864F5C8CA07" Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\gaze-grid\SignIn" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="Installed" Value="1" Type="integer" KeyPath="yes" />
        </RegistryKey>
      </Component>
      <Component Id="gaze_gridMode" Guid="30BCF52D-69E3-4E56-813B-7FCA2DD5F966" Win64="yes">
        <RegistryValue Root="HKLM" Key="Software\gaze-grid\Installer" Name="TrustCertificate" Value="[GAZE_GRID_TRUST_CERTIFICATE]" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\gaze-grid\Installer" Name="SignIn" Value="[GAZE_GRID_SIGN_IN]" Type="string" />
      </Component>
      <!-- Trust is deliberately persistent: never remove a root that may already
           be trusted by an administrator or used by another gaze-grid release. -->
      <Component Id="gaze_gridCertificate" Guid="*" Win64="yes" Permanent="yes">
        <Condition>GAZE_GRID_TRUST_CERTIFICATE = "1"</Condition>
        <RegistryValue Root="HKLM" Key="Software\gaze-grid\Certificates" Name="@GAZE_GRID_CERTIFICATE_THUMBPRINT@" Value="1" Type="integer" KeyPath="yes" />
        <iis:Certificate Id="gaze_gridTrust" Name="GazeGrid" BinaryKey="gaze_gridPublicCer" StoreLocation="localMachine" StoreName="root" Request="no" Overwrite="no" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="gaze_gridMenu">
      <!-- One direct shortcut serves either executable without MSI advertisement.
           Non-advertised shortcuts require their own HKCU registry key path. -->
      <Component Id="gaze_gridStartMenu" Guid="81AE68C6-C223-4B3A-8C6A-ACCE614CBA76" Win64="yes">
        <Shortcut Id="gaze_gridStart" Name="gaze-grid" Icon="gaze_grid.exe" IconIndex="0" Advertise="no" Target="[INSTALL_ROOT]gaze-grid.exe" WorkingDirectory="INSTALL_ROOT" />
        <RemoveFolder Id="Removegaze_gridMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\gaze-grid\Installer" Name="StartMenu" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="SystemFolder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="gaze_gridMenu" Name="gaze-grid" />
      </Directory>
    </DirectoryRef>
    <ComponentGroup Id="gaze_gridExecutables">
      <ComponentRef Id="gaze_gridSigned" />
      <ComponentRef Id="gaze_gridUnsigned" />
      <ComponentRef Id="gaze_gridStartMenu" />
      <ComponentRef Id="gaze_gridMode" />
      <ComponentRef Id="gaze_gridStartup" />
      <ComponentRef Id="gaze_gridSignInSettings" />
      <ComponentRef Id="gaze_gridCertificate" />

    </ComponentGroup>
  </Fragment>
  <Fragment>
    <SetProperty Id="DefaultUIFont" Value="gaze_grid_Font_Normal" Before="LaunchConditions" Sequence="ui">1</SetProperty>
    <UI Id="gaze_gridUI">
      <UIRef Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixShellExecTarget" Value="[INSTALL_ROOT]gaze-grid.exe" Order="1">WIXUI_EXITDIALOGOPTIONALCHECKBOX = "1" AND NOT Installed AND NOT REMOVE AND UILevel = 5</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="Launchgaze_grid" Order="2">WIXUI_EXITDIALOGOPTIONALCHECKBOX = "1" AND NOT Installed AND NOT REMOVE AND UILevel = 5</Publish>
      <!-- MSI installer units do not grow with DefaultUIFont. Keep explicit
           room for 12-point body text, 14-point titles and option labels. -->
      <TextStyle Id="gaze_grid_Font_Normal" FaceName="Tahoma" Size="12" />
      <TextStyle Id="gaze_grid_Font_Title" FaceName="Tahoma" Size="14" Bold="yes" />
      <Dialog Id="gaze_gridTrustDlg" Width="520" Height="360" Title="gaze-grid accessibility permissions">
        <Control Id="Title" Type="Text" X="20" Y="12" Width="480" Height="26" Text="{\gaze_grid_Font_Title}Choose Windows accessibility access" />
        <Control Id="Explanation" Type="Text" X="20" Y="44" Width="480" Height="44" Text="A trusted signature and installation in Program Files grant UIAccess, allowing input to elevated windows. Optional sign-in startup is registered separately with Windows accessibility." />
        <Control Id="TrustExplanation" Type="Text" X="20" Y="92" Width="480" Height="48" Text="Accepting installs the existing self-signed GazeGrid certificate in this computer's Trusted Root Certification Authorities store. This trusts software signed with this identity for all users. Accept only if you trust the publisher and have verified the certificate." />
        <Control Id="Fingerprint" Type="Text" X="20" Y="145" Width="480" Height="30" Text="Certificate thumbprint: @GAZE_GRID_CERTIFICATE_THUMBPRINT@" />
        <Control Id="Choice" Type="RadioButtonGroup" Property="GAZE_GRID_TRUST_CERTIFICATE" X="20" Y="182" Width="480" Height="54">
          <RadioButtonGroup Property="GAZE_GRID_TRUST_CERTIFICATE">
            <RadioButton Value="0" X="0" Y="0" Width="475" Height="24" Text="Decline - install the unsigned, limited-access app" />
            <RadioButton Value="1" X="0" Y="28" Width="475" Height="24" Text="Accept - trust the certificate and install the signed UIAccess app" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Limitations" Type="Text" X="20" Y="242" Width="480" Height="34" Text="If you decline, gaze-grid cannot send input to higher-privilege windows and cannot stay on top of all windows. Normal desktop input remains available." />
        <Control Id="Persistence" Type="Text" X="20" Y="282" Width="480" Height="34" Text="Certificate trust remains after uninstall. An administrator can remove it with certlm.msc under Trusted Root Certification Authorities / Certificates." />
        <Control Id="Next" Type="PushButton" X="310" Y="324" Width="90" Height="24" Default="yes" Text="Next">
          <Publish Property="GAZE_GRID_SIGN_IN" Value="{}" Order="1">GAZE_GRID_TRUST_CERTIFICATE &lt;&gt; "1"</Publish>
          <Publish Event="EndDialog" Value="Return" Order="2">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="410" Y="324" Width="90" Height="24" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      <Dialog Id="gaze_gridSignInDlg" Width="520" Height="280" Title="gaze-grid Windows startup">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="480" Height="26" Text="{\gaze_grid_Font_Title}Windows startup" />
        <Control Id="Explanation" Type="Text" X="20" Y="48" Width="480" Height="48" Text="gaze-grid can start on the Windows sign-in screen before you enter your password. It uses the existing keyboard interface with prediction disabled." />
        <Control Id="Enable" Type="CheckBox" X="20" Y="106" Width="480" Height="24" Property="GAZE_GRID_SIGN_IN" CheckBoxValue="1" Text="Start gaze-grid before Windows sign-in">
          <Condition Action="disable">GAZE_GRID_TRUST_CERTIFICATE &lt;&gt; "1"</Condition>
          <Condition Action="enable">GAZE_GRID_TRUST_CERTIFICATE = "1"</Condition>
        </Control>
        <Control Id="Details" Type="Text" X="20" Y="140" Width="480" Height="48" Text="Requires certificate trust. To use your current keyboard and gaze preferences, open Settings > Keyboard > Windows sign-in after installation. Eye tracking also depends on Tobii availability before sign-in." />
        <Control Id="Startup" Type="CheckBox" X="20" Y="196" Width="480" Height="24" Property="GAZE_GRID_STARTUP" CheckBoxValue="1" Text="Start with Windows" />
        <Control Id="Next" Type="PushButton" X="310" Y="244" Width="90" Height="24" Default="yes" Text="Next"><Publish Event="EndDialog" Value="Return">1</Publish></Control>
        <Control Id="Cancel" Type="PushButton" X="410" Y="244" Width="90" Height="24" Cancel="yes" Text="Cancel"><Publish Event="SpawnDialog" Value="CancelDlg">1</Publish></Control>
      </Dialog>
      <Dialog Id="gaze_gridTobiiDlg" Width="520" Height="280" Title="gaze-grid eye tracking setup">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="480" Height="26" Text="{\gaze_grid_Font_Title}Tobii eye tracking prerequisites" />
        <Control Id="BuildSupport" Type="Text" X="20" Y="45" Width="480" Height="42" Text="@GAZE_GRID_TOBII_INSTALL_MESSAGE@" />
        <Control Id="Software" Type="Text" X="20" Y="96" Width="480" Height="50" Text="Install the Tobii Experience driver package, then the Tobii Experience app. That installation supplies the Tobii Stream Engine DLL. gaze-grid uses the installed DLL and does not bundle it." />
        <Control Id="Download" Type="Text" X="20" Y="152" Width="480" Height="24" Text="Official setup: https://gaming.tobii.com/getstarted/" />
        <Control Id="Fallback" Type="Text" X="20" Y="185" Width="480" Height="40" Text="Complete Tobii setup and calibration, then restart gaze-grid. Mouse dwell remains available without Tobii software or a connected eye tracker." />
        <Control Id="Next" Type="PushButton" X="310" Y="244" Width="90" Height="24" Default="yes" Text="Next">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="410" Y="244" Width="90" Height="24" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      <InstallUISequence>
        <Show Dialog="gaze_gridTobiiDlg" Before="gaze_gridTrustDlg">NOT Installed</Show>
        <Show Dialog="gaze_gridTrustDlg" Before="gaze_gridSignInDlg">NOT Installed</Show>
        <Show Dialog="gaze_gridSignInDlg" Before="WelcomeEulaDlg">NOT Installed</Show>
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
